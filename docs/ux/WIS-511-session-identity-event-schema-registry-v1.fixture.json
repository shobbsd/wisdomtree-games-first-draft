    "session.leaderboard.updated": "session.leaderboard.updated.v1",
    "session.flow_state.updated": "session.flow_state.updated.v1",
    "session.lifecycle.transport_connect_failed": "session.lifecycle.transport_connect_failed.v1",
    "session.sync.desync_detected": "session.sync.desync_detected.v1",
