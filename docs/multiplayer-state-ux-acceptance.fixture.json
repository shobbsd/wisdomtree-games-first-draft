  "parityAcceptance": {
    "preMatch": [
      "Queue fallback copy and CTA labels match exactly on desktop and mobile.",
      "Readiness status vocabulary is identical across right-rail and bottom-sheet roster layouts.",
      "Countdown lock timing and disconnect pause cap are identical across platforms."
    ],
    "urgentAlerts": [
      "Priority preemption ordering (P0 over P1 and P2) is identical on desktop and mobile.",
      "Dwell timing parity: P0=1.8s, P1=1.5s, P2=1.2s.",
      "Alert placement can adapt for safe areas, but P0 remains highest visual priority on both."
    ],
    "postMatch": [
      "Results summary card includes the same mandatory data fields across platforms.",
      "Tie labels use the same token format in end-card and leaderboard contexts.",
      "CTA labels and resulting routes are identical even when layout differs."
    ]
  }
