    {
      "id": "PO-BACK-TO-LOBBY",
      "state": "post_match.route_choice",
      "event": "back_to_lobby",
      "uiResponse": "Return user to same lobby room context.",
      "copy": "Back to Lobby",
      "priority": "P2"
